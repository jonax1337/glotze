<?xml version="1.0" encoding="utf-8"?>
<!-- The settings button of Glas lights up as a white disc while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/focus_in_ms"
    android:exitFadeDuration="@integer/focus_out_ms">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/glass_focus_fill" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
