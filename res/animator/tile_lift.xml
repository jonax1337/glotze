<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1.05" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1.05" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="translationZ" android:valueTo="4dp" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="@integer/focus_in_ms" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="scaleX" android:valueTo="1.1" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/focus_in_ms" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="scaleY" android:valueTo="1.1" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/focus_in_ms" android:interpolator="@android:interpolator/decelerate_quint" android:propertyName="translationZ" android:valueTo="@dimen/tile_lift" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="@integer/focus_out_ms" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/focus_out_ms" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/focus_out_ms" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="translationZ" android:valueTo="0" android:valueType="floatType" />
        </set>
    </item>
</selector>
