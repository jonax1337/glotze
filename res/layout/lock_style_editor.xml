<?xml version="1.0" encoding="utf-8"?>
<!-- The live screen saver with a solid bar for picking each setting's variant, like the iOS lock screen editor. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/lock_screen" />

    <LinearLayout
        android:id="@+id/lock_editor_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:gravity="center_horizontal"
        android:minWidth="420dp"
        android:orientation="vertical"
        android:paddingBottom="14dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/lock_editor_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:tag="semibold"
            android:textAllCaps="true"
            android:textColor="?attr/textMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lock_editor_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:tag="semibold"
            android:textColor="?attr/textPrimary"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lock_style_keys"
            android:textColor="?attr/textMuted"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
