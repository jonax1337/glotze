<?xml version="1.0" encoding="utf-8"?>
<!-- The gap between tiles is padding, not margin, and the width is a share of the row: a partly filled
     row keeps the grid's column pitch because its weight sum is the number of columns, see TileGrid. -->
<local.tvhome.TileView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/stage_tile_gap_half"
    android:paddingRight="@dimen/stage_tile_gap_half">

    <local.tvhome.AspectFrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:stateListAnimator="@animator/tile_lift">

        <ImageView
            android:id="@+id/artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Draws the focus ring over the artwork while the tile has focus; in Glas also the glass edge. -->
        <View
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:duplicateParentState="true" />
    </local.tvhome.AspectFrameLayout>

    <!-- The app's name beneath the focused tile, in Glas only. It stands on the ground, not on a white
         focus fill, so it stays white rather than taking the focused textPrimary. -->
    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/glass_tile_label_gap"
        android:alpha="0"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:shadowColor="@color/text_shadow"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:singleLine="true"
        android:stateListAnimator="@animator/label_reveal"
        android:tag="semibold"
        android:textColor="@color/glass_label"
        android:textSize="@dimen/glass_tile_label_text"
        android:visibility="?attr/tileLabelVisibility" />
</local.tvhome.TileView>
