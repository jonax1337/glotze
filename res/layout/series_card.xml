<?xml version="1.0" encoding="utf-8"?>
<!-- One followed series in the width of a grid column: the poster (2:3, full height) on the left, then
     title and episode. The card clips to its rounded background, see SeriesCardView. -->
<local.tvhome.SeriesCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/stage_tile_gap_half"
    android:paddingRight="@dimen/stage_tile_gap_half">

    <local.tvhome.AspectFrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:stateListAnimator="@animator/tile_lift">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- The width follows the height, see SeriesCardView. -->
            <FrameLayout
                android:id="@+id/poster_frame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/surface_card_raised">

                <ImageView
                    android:id="@+id/poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/stage_series_badge_margin"
                    android:includeFontPadding="false"
                    android:paddingBottom="@dimen/stage_series_badge_padding_vertical"
                    android:paddingLeft="@dimen/stage_series_badge_padding_horizontal"
                    android:paddingRight="@dimen/stage_series_badge_padding_horizontal"
                    android:paddingTop="@dimen/stage_series_badge_padding_vertical"
                    android:singleLine="true"
                    android:tag="bold"
                    android:text="@string/series_badge_new"
                    android:textColor="@color/glotze_ink"
                    android:textSize="@dimen/stage_series_badge_text"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="@dimen/stage_series_text_padding_start"
                android:paddingRight="@dimen/stage_series_text_padding_end">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:tag="semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/stage_series_title_text" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stage_series_subtitle_gap"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:tag="medium"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/stage_series_subtitle_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Draws the lime focus ring over the card while it has focus. -->
        <View
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:duplicateParentState="true" />
    </local.tvhome.AspectFrameLayout>
</local.tvhome.SeriesCardView>
