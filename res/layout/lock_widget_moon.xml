<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/lock_weather_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="20dp">

    <ImageView
        android:id="@+id/moon_glyph"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/moon_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:tag="medium"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:background="@color/lock_text_secondary"
        android:alpha="0.4" />

    <TextView
        android:id="@+id/world_clock_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:text="@string/world_clock_city"
        android:textColor="@color/lock_text_secondary"
        android:textSize="18sp" />

    <TextClock
        android:id="@+id/world_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:tag="semibold"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />
</LinearLayout>
