<?xml version="1.0" encoding="utf-8"?>
<!-- The "Bühne": a huge clock, the date, two small chips and Glotze (Soft Solid only) on one screen, with the
     dock of apps along the bottom. Everything is placed by margins from the
     top left, as in the 1920x1080 design (one dp is two of its pixels). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="@dimen/stage_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The design places the clock and the date, see StageClock and StageDate. -->
    <TextClock
        style="?attr/stageClockStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/stage_clock_left"
        android:fontFeatureSettings="tnum"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="?attr/textPrimary"
        android:textSize="@dimen/stage_clock_size" />

    <TextClock
        style="?attr/stageDateStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/stage_margin_horizontal"
        android:format12Hour="EEEE, d. MMMM"
        android:format24Hour="EEEE, d. MMMM"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/stage_margin_horizontal"
        android:layout_marginTop="@dimen/stage_chips_top"
        android:orientation="horizontal">

        <!-- Both chips stay hidden until there is something to show, see WeatherChip and DepartureChip. -->
        <LinearLayout
            android:id="@+id/weather_chip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/stage_chip_height"
            android:layout_marginRight="@dimen/stage_chip_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/stage_chip_padding"
            android:paddingRight="@dimen/stage_chip_padding"
            android:visibility="gone">

            <ImageView
                android:id="@+id/weather_chip_glyph"
                android:layout_width="@dimen/stage_chip_glyph"
                android:layout_height="@dimen/stage_chip_glyph"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/weather_chip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/stage_chip_inner_gap"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:tag="medium"
                android:textColor="?attr/textPrimary"
                android:textSize="@dimen/stage_chip_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/departure_chip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/stage_chip_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/stage_chip_padding"
            android:paddingRight="@dimen/stage_chip_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/departure_chip_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingBottom="@dimen/stage_badge_padding_vertical"
                android:paddingLeft="@dimen/stage_badge_padding_horizontal"
                android:paddingRight="@dimen/stage_badge_padding_horizontal"
                android:paddingTop="@dimen/stage_badge_padding_vertical"
                android:singleLine="true"
                android:tag="bold"
                android:textColor="?attr/badgeTextColor"
                android:textSize="@dimen/stage_badge_text" />

            <TextView
                android:id="@+id/departure_chip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/stage_chip_inner_gap"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:tag="medium"
                android:textColor="?attr/textPrimary"
                android:textSize="@dimen/stage_chip_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Glotze glances at whatever has the focus, see HomeActivity. -->
    <local.tvhome.GlotzeView
        android:id="@+id/hero_glotze"
        android:layout_width="@dimen/stage_mascot_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/stage_mascot_left"
        android:layout_marginTop="@dimen/stage_mascot_top"
        android:visibility="?attr/mascotVisibility" />

    <!-- HomeShelf fills the dock with up to five app tiles. Its cells share the width by weight, so
         they sit on the same five columns as the grid below, whose first row peeks out beneath. -->
    <LinearLayout
        android:id="@+id/shelf_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/stage_row_inset"
        android:layout_marginRight="@dimen/stage_row_inset"
        android:layout_marginTop="@dimen/stage_shelf_top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />
</FrameLayout>
