<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="16dp"
    android:stateListAnimator="@animator/row_lift">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/icon_tile"
        android:layout_height="@dimen/icon_tile"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:tint="@android:color/white" />

    <TextView
        android:id="@+id/row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/textPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:duplicateParentState="true"
        android:textColor="?attr/textMuted"
        android:textSize="16sp" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="?attr/iconChevron"
        android:tint="?attr/textMuted" />
</LinearLayout>
