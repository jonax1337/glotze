<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.tvhome"
    android:versionCode="6"
    android:versionName="0.6">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Weather only: place via ipapi.co, forecast via Open-Meteo. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A launcher must see every installed app; on Android 11+ that needs this permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Opening Google TV's pairing of remotes, which demands BLUETOOTH_CONNECT; Android 12+ grants it for this one. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Choosing the screen saver and its start time; both are granted once over ADB, see ScreenSaver. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Ordering apps by use; granted once over ADB, see UsageHistory. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Hearing the music for the lock screen's music reaction; granted once over ADB, see SoundLevel. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Optional: the calendar widget of the screen saver; without it the app works fully. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_glotze_launcher"
        android:roundIcon="@mipmap/ic_glotze_launcher"
        android:label="@string/app_name"
        android:theme="@style/HomeTheme">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PlacesActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".LockScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".LockStyleActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Only for reading the playing media sessions, see NowPlayingWidget. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".LockScreenDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
